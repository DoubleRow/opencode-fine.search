{
  "name": "opencode-fine.search",
  "version": "1.0.1",
  "description": "OpenCode 会话全文检索：Desktop GUI + TUI 插件 + 旁路精确索引",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build:gui": "vite build --config plugin/vite.config.ts",
    "dev:gui": "vite build --config plugin/vite.config.ts --watch",
