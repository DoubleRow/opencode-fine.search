    "lint": "oxlint plugin lib tests bin",
    "test": "node --test"
  },
  "devDependencies": {
    "@opencode/client": "2.2.6",
    "@opencode/plugin": "2.2.6",
    "@opencode/theme": "2.2.6",
    "@opentui/core": "0.8.2",
    "@opentui/solid": "0.8.2",
    "@types/node": "26.6.6",
    "effect": "4.0.6",
    "electron": "45.2.2",
    "oxlint": "^1.91.0",
    "solid-js": "1.9.18",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.15"
  }
}